# Development Dockerfile for Admin Server
FROM node:22-bookworm-slim

# Install OpenSSL for Prisma
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files
COPY package.json package-lock.json ./

# Install all dependencies (including dev dependencies for nodemon)
RUN npm install

# Copy prisma schema first and generate
COPY prisma ./prisma
RUN npx prisma generate

# Expose the port
EXPOSE 3000

# The source code will be mounted as a volume, so we don't copy it here
# Command will be overridden in docker-compose.yml
CMD ["npm", "run", "dev"]
