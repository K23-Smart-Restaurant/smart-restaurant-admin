generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String         @id @default(uuid())
  email                String         @unique
  passwordHash         String?
  role                 UserRole
  name                 String?
  phoneNumber          String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  authProvider         String         @default("email")
  googleId             String?        @unique
  isActive             Boolean        @default(true)
  isVerified           Boolean        @default(false)
  lastLoginAt          DateTime?
  passwordResetExpires DateTime?
  passwordResetToken   String?        @db.VarChar(500)
  verificationToken    String?        @db.VarChar(500)
  verificationTokenExpiry DateTime?
  ordersAsCustomer     Order[]        @relation("CustomerOrders")
  ordersAsWaiter       Order[]        @relation("WaiterOrders")
  refreshTokens        RefreshToken[]
  restaurantsOwned     Restaurant[]
  reviews              Review[]

  @@index([email])
  @@index([googleId])
  @@map("User")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique @db.VarChar(500)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("RefreshToken")
}

model Restaurant {
  id             String          @id @default(uuid())
  name           String
  address        String?
  phoneNumber    String?
  adminId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  logoUrl        String?
  categories     Category[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  admin          User            @relation(fields: [adminId], references: [id])
  tables         Table[]

  @@index([adminId])
  @@map("Restaurant")
}

model Table {
  id               String      @id @default(uuid())
  tableNumber      Int         @unique
  capacity         Int
  status           TableStatus @default(AVAILABLE)
  qrCode           String?
  restaurantId     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  description      String?
  location         String?
  qrToken          String?     @unique @db.VarChar(500)
  qrTokenCreatedAt DateTime?
  isActive         Boolean     @default(true)
  orders           Order[]
  restaurant       Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([tableNumber])
  @@index([status])
  @@index([location])
  @@index([restaurantId])
  @@map("Table")
}

model Category {
  id           String      @id @default(uuid())
  name         String
  description  String?
  displayOrder Int         @default(0)
  restaurantId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  isActive     Boolean     @default(true)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
  @@map("Category")
}

model MenuItemPhoto {
  id         String   @id @default(uuid())
  menuItemId String
  url        String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([menuItemId, isPrimary])
  @@map("MenuItemPhoto")
}

model ModifierGroup {
  id            String      @id @default(uuid())
  name          String
  description   String?
  selectionType String      @default("multiple")
  isRequired    Boolean     @default(false)
  minSelections Int?        @default(0)
  maxSelections Int?
  displayOrder  Int         @default(0)
  status        String      @default("active")
  menuItemId    String
  restaurantId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  modifiers     Modifier[]
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  restaurant    Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@index([restaurantId])
  @@index([status])
  @@map("ModifierGroup")
}

model MenuItem {
  id                   String          @id @default(uuid())
  name                 String
  description          String?
  category             MenuCategory
  price                Decimal         @db.Decimal(10, 2)
  imageUrl             String?
  isAvailable          Boolean         @default(true)
  isSoldOut            Boolean         @default(false)
  isChefRecommendation Boolean         @default(false)
  preparationTime      Int?
  categoryId           String?
  restaurantId         String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  categoryModel        Category?       @relation(fields: [categoryId], references: [id])
  restaurant           Restaurant?     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  photos               MenuItemPhoto[]
  modifiers            ModifierGroup[]
  orderItems           OrderItem[]
  reviews              Review[]

  @@index([category, isAvailable])
  @@index([isAvailable])
  @@index([categoryId])
  @@index([restaurantId])
  @@map("MenuItem")
}

model Modifier {
  id              String        @id @default(uuid())
  name            String
  price           Decimal       @default(0) @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  displayOrder    Int           @default(0)
  modifierGroupId String
  status          String        @default("active")
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@index([modifierGroupId])
  @@index([status])
  @@map("Modifier")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     Int           @unique @default(autoincrement())
  tableId         String
  userId          String?
  guestName       String?
  guestContact    String?
  waiterId        String?
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus   PaymentStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  paidAt          DateTime?
  billRequested   Boolean       @default(false)
  billRequestedAt DateTime?
  orderToken      String?
  table           Table         @relation(fields: [tableId], references: [id])
  customer        User?         @relation("CustomerOrders", fields: [userId], references: [id])
  waiter          User?         @relation("WaiterOrders", fields: [waiterId], references: [id])
  orderItems      OrderItem[]
  payment         Payment?

  @@index([orderNumber])
  @@index([tableId, status])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
  @@index([waiterId])
  @@map("Order")
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  menuItemId          String
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  subtotal            Decimal         @db.Decimal(10, 2)
  itemStatus          OrderItemStatus @default(QUEUED)
  specialInstructions String?
  createdAt           DateTime        @default(now())
  menuItem            MenuItem        @relation(fields: [menuItemId], references: [id])
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("OrderItem")
}

model Payment {
  id                    String                   @id @default(uuid())
  orderId               String                   @unique
  amount                Decimal                  @db.Decimal(10, 2)
  method                PaymentMethod
  status                PaymentTransactionStatus @default(PENDING)
  stripePaymentIntentId String?                  @unique
  transactionId         String?
  metadata              Json?
  createdAt             DateTime                 @default(now())
  completedAt           DateTime?
  order                 Order                    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@map("Payment")
}

model Review {
  id         String   @id @default(uuid())
  rating     Int
  comment    String
  userId     String
  menuItemId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@index([menuItemId])
  @@index([userId])
  @@index([createdAt])
  @@map("Review")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  WAITER
  KITCHEN_STAFF
  CUSTOMER
  GUEST
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum MenuCategory {
  APPETIZER
  MAIN_COURSE
  DESSERT
  BEVERAGE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  BILL_REQUESTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  CASH
  CARD
  E_WALLET
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum OrderItemStatus {
  QUEUED
  COOKING
  READY
}
